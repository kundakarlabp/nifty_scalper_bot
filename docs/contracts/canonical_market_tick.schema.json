{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical_market_tick",
  "title": "Canonical market tick",
  "type": "object",
  "required": [
    "symbol",
    "timestamp",
    "source",
    "last_price",
    "ltp"
  ],
  "properties": {
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "instrument_token": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "last_price": {
      "type": "number",
      "minimum": 0
    },
    "ltp": {
      "type": "number",
      "minimum": 0
    },
    "bid": {
      "type": "number",
      "minimum": 0
    },
    "ask": {
      "type": "number",
      "minimum": 0
    },
    "spread": {
      "type": "number",
      "minimum": 0
    },
    "bid_quantity": {
      "type": "number",
      "minimum": 0
    },
    "ask_quantity": {
      "type": "number",
      "minimum": 0
    },
    "depth": {
      "type": "object"
    },
    "oi": {
      "type": "number"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "freshness": {
      "type": "object"
    },
    "stale": {
      "type": "boolean"
    },
    "tradable_quote": {
      "type": "boolean"
    },
    "trace_id": {
      "type": "string"
    },
    "event_timestamp_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "received_timestamp_ms": {
      "type": "number",
      "minimum": 0
    },
    "received_monotonic_ns": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp_quality": {
      "type": "string",
      "minLength": 1
    },
    "source_timestamp_valid": {
      "type": "boolean"
    },
    "subscription_generation": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "quote_update_version": {
      "type": [
        "integer",
        "number",
        "string"
      ]
    },
    "depth_available": {
      "type": "boolean"
    },
    "depth_two_sided": {
      "type": "boolean"
    },
    "depth_complete_5x5": {
      "type": "boolean"
    },
    "bid_depth_levels": {
      "type": "integer",
      "minimum": 0
    },
    "ask_depth_levels": {
      "type": "integer",
      "minimum": 0
    },
    "bid_depth_qty_5": {
      "type": "number",
      "minimum": 0
    },
    "ask_depth_qty_5": {
      "type": "number",
      "minimum": 0
    },
    "depth_imbalance_5": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -1,
      "maximum": 1
    },
    "microprice": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "bid_qty": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "ask_qty": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "volume_delta": {
      "type": "number",
      "minimum": 0
    },
    "volume_cumulative": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": true
}
