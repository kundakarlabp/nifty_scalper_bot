ples = 0
            self._critical_latency_samples = 0
            self._healthy_latency_samples = 0
            self._latency_degraded = False
            self._snapshot: SupervisorSnapshot | None = None

        @property
        def thread(self) -> threading.Thread | None:
            return self._thread

        @property
        def state(self) -> SupervisorState:
            with self._lock:
                return self._state

        def start(self) -> threading.Thread:
            with self._lock:
                if self._thread is not None and self._thread.is_alive():
                    return self._thread
                self._stop.clear()
                self._state = SupervisorState.STARTING
                self._thread = threading.Thread(
                    target=self._run,
                    name="market-data-supervisor",
                    daemon=True,
                )
                self._thread.start()
                return self._thread

        def stop(self, timeout: float = 3.0) -> bool:
            with self._lock:
                self._state = SupervisorState.STOPPING
                thread = self._thread
                self._stop.set()
            if thread is not None and thread is not threading.current_thread():
                thread.join(timeout=max(timeout, 0.05))
            alive = bool(thread is not None and thread.is_alive())
            with self._lock:
                if not alive:
                    self._thread = None
                    self._state = SupervisorState.STOPPED
            return not alive

        def _transition(self, state: SupervisorState, reason: str) -> None:
            with self._lock:
                previous = self._state
                self._state = state
            if previous != state:
                LOGGER.info(
                    "MARKET_DATA_SUPERVISOR_STATE previous=%s state=%s reason=%s",
                    previous.value,
                    state.value,
                    reason,
                    extra={
                        "event": "MARKET_DATA_SUPERVISOR_STATE",
                        "previous": previous.value,
                        "state": state.value,
                        "reason": reason,
                    },
                )

        def _pressure(self) -> Mapping[str, Any]:
            getter = getattr(self.mdm, "get_tick_pressure_stats", None)
            if callable(getter):
                try:
                    value = getter() or {}
                    if isinstance(value, Mapping):
                        return value
                except Exception:
                    pass
            return {}

        def _latency_values(self) -> tuple[float, float, float, float, float]:
            pressure = self._pressure()
            event_loop = float(getattr(self.mdm, "_event_loop_lag_ms", 0.0) or 0.0)
            tick_p99 = float(
                pressure.get("tick_p99_ms")
                or presssure.get("one_tick_p99_ms")
        