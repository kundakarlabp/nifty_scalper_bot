# ============================================================
# NIFTY SCALPER BOT - PRODUCTION .env FILE
# ============================================================
# This is the CORRECTED .env file - commit this to your repo root
# ============================================================

# ====== CRITICAL: LIVE TRADING ENABLEMENT ======
ENABLE_LIVE=true
ENABLE_LIVE_TRADING=true
EXECUTION_MODE=LIVE

# ====== WARMUP CONFIGURATION ======
MIN_INDICATOR_BARS=10
STRATEGY_MIN_INDICATOR_BARS=10
SIGNAL_COOLDOWN_SECONDS=3.0
TRADE_COOLDOWN_SECONDS=10.0

# ====== SESSION CONTROLS ======
# Set to false in production, true only for testing outside market hours
SESSION_ALLOW_OUT_OF_HOURS=false
ALLOW_OFFHOURS_TESTING=false

# ====== FORCED SIGNAL CONTROLS (CRITICAL!) ======
# FORCE_SIGNAL=false means use real strategy signals only
# FEATURE_DISABLE_EARLY_FORCED_SIGNALS=true prevents spam
FORCE_SIGNAL=false
FEATURE_DISABLE_EARLY_FORCED_SIGNALS=true

# ====== SIGNAL CONFIDENCE ======
# Minimum confidence required to execute a signal (0.0 to 1.0)
# 0.50 = 50% confidence minimum (matches base score)
GLOBAL_MIN_SIGNAL_CONFIDENCE=0.50

# ====== ELITE STRATEGIES ======
ELITE_STRATEGIES_ENABLED=true
ELITE_MAX_CONCURRENT_STRATEGIES=5
ELITE_POSITION_SIZE_PCT=1.5

# SMC Liquidity Strategy
SMC_ENABLED=true
SMC_MIN_CONFIDENCE=45.0
SMC_COOLDOWN=60.0
SMC_SWEEP_DISTANCE=15.0
SMC_VOLUME_SPIKE=2.0

# VWAP Pro Strategy
VWAP_PRO_ENABLED=true
VWAP_ENABLED=true
VWAP_MIN_CONFIDENCE=40.0
VWAP_EMA_PERIOD=50
VWAP_PROXIMITY_PCT=0.15

# OI Max Pain Strategy
OI_MAX_PAIN_ENABLED=true
OI_MIN_CONFIDENCE=50.0
OI_MIN_DEVIATION_PCT=0.5

# RSI Divergence Strategy
RSI_DIV_ENABLED=true
RSI_MIN_CONFIDENCE=48.0
RSI_DIV_MIN_CONFIDENCE=48.0
RSI_PERIOD=14

# Opening Range Breakout Strategy
ORB_PRO_ENABLED=true
ORB_ENABLED=true
ORB_MIN_CONFIDENCE=55.0
ORB_MINUTES=15

# Gamma Scalping Strategy
GAMMA_SCALPING_ENABLED=true
GAMMA_ENABLED=true
GAMMA_MIN_CONFIDENCE=60.0
GAMMA_MIN_VALUE=0.0005

# CPR Breakout Strategy
CPR_ENABLED=true
CPR_MIN_CONFIDENCE=55.0
CPR_NARROW_THRESHOLD=0.25

# BB Squeeze Strategy
BB_SQUEEZE_ENABLED=true
BB_MIN_CONFIDENCE=50.0
BB_SQUEEZE_THRESHOLD=0.5

# Order Flow Strategy
ORDER_FLOW_ENABLED=true
ORDER_FLOW_MIN_CONFIDENCE=55.0
ORDER_FLOW_IMBALANCE_RATIO=1.5

# Straddle Theta Strategy
STRADDLE_THETA_ENABLED=true
STRADDLE_ENABLED=true
STRADDLE_MIN_CONFIDENCE=60.0
STRADDLE_ADX_THRESHOLD=25.0
STRADDLE_MIN_IV=12.0

# ====== RISK MANAGEMENT ======
RISK_MAX_DAILY_TRADES=30
RISK_MAX_ORDER_NOTIONAL=200000.0
RISK_ALLOW_SHORT=true
RISK_PER_TRADE_CAP_PCT=1.5
RISK__SOFT_OVERRIDE=false

# ====== POSITION LIFECYCLE ======
LIFECYCLE_TP1_R=1.0
LIFECYCLE_TP1_PARTIAL=0.6
LIFECYCLE_TP2_R_TREND=1.8
LIFECYCLE_TP2_R_RANGE=1.4
LIFECYCLE_TRAIL_ATR_MULT=0.8
LIFECYCLE_TIME_STOP_MIN=12

# ====== POLLING MODE (Railway Compatible) ======
WEBSOCKET__DISABLED=true
TELEGRAM__WEBHOOK_ENABLED=false
POLL_INTERVAL_MS=700
POLL_BATCH_SIZE=50
POLL_INTERVAL_MS_JITTER_PCT=0.15
POLL_REQUIRE_DEPTH=false
POLL_WARN_RATE_LIMIT=false

# ====== RATE LIMITING ======
RATE_LIMIT_ORDERS_CAPACITY=5
RATE_LIMIT_ORDERS_REFILL_PER_SEC=5.0
RATE_LIMIT_REST_CAPACITY=10
RATE_LIMIT_REST_REFILL_PER_SEC=10.0
RATE_LIMIT_HIST_CAPACITY=2
RATE_LIMIT_HIST_REFILL_PER_SEC=1.0

# ====== QUOTE/TICK SETTINGS ======
QUOTE_STALE_THRESHOLD_MS=5000
TICK_STALE_MS=2000
MAX_ALLOWED_STALENESS=5000
RISK_QUOTE_STALE_MS=5000

# ====== EXECUTION SETTINGS ======
EXECUTION_RETRY_ATTEMPTS=3
EXECUTION_RETRY_DELAY_MS=500
ORDER_MIN_SPACING_SECONDS=1.5

# ====== SHADOW/PAPER TRADING ======
SHADOW_DRIFT_THRESHOLD_BPS=20
SHADOW_DRIFT_AUTO_PAUSE=false

# ====== REGIME FILTER ======
REGIME_FILTER_BYPASS=false

# ====== RISK OVERRIDES ======
RISK_SIGNAL_DEBOUNCE_SECONDS=5.0
SKIP_APP_RISK=false

# ====== LOGGING ======
LOG_LEVEL=DEBUG

# ====== ZERODHA CREDENTIALS ======
# These should be set in Railway, not committed to repo!
# ZERODHA_API_KEY=your_api_key_here
# ZERODHA_ACCESS_TOKEN=your_access_token_here
# KITE_API_KEY=your_api_key_here
# KITE_ACCESS_TOKEN=your_access_token_here

# ====== TELEGRAM ======
# These should be set in Railway, not committed to repo!
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ENABLED=true
