# NIFTY SCALPER BOT — AWS LIGHTSAIL LIVE ENVIRONMENT
# Store only at:
# /home/ubuntu/.config/niftybot/niftybot.env
#
# Never commit this populated file.
# Keep comments on separate lines; do not append inline comments to values.

# =============================================================================
# 1. HOST / SERVICE
# =============================================================================
APP_ENV=production
TZ=Asia/Kolkata
DEPLOYMENT_PLATFORM=aws_lightsail
BOT_APP_DIR=/home/ubuntu/nifty_scalper_bot
BOT_SERVICE_NAME=niftybot
BOT_ENV_FILE=/home/ubuntu/.config/niftybot/niftybot.env
DATA_DIR=/home/ubuntu/nifty_scalper_bot/data
PORT=8080
LOG_LEVEL=INFO
ALLOW_DEBUG_ENV=false

ADMIN_PASSWORD="REPLACE_WITH_LONG_RANDOM_PASSWORD"
BOT_ADMIN_API_URL=http://127.0.0.1:8081
BOT_ADMIN_PUBLIC_URL=http://REPLACE_LIGHTSAIL_PUBLIC_IP:8081/admin
BOT_ADMIN_REVISION_CHECK_SECONDS=120
BOT_UPDATER_STALE_TIMEOUT_SECONDS=900

# =============================================================================
# 2. ZERODHA KITE CONNECT
# Use only this canonical BROKER_* set. Do not duplicate KITE_* and ZERODHA_*.
# The access token is a session credential and must be replaced when renewed.
# =============================================================================

BROKER_BASE_URL=https://api.kite.trade
BROKER_WS_URL=wss://ws.kite.trade
BROKER_MARGIN_SEGMENT=equity
ZERODHA_WS_ORIGIN=https://kite.zerodha.com
ZERODHA_WS_CONNECT_TIMEOUT=60
ZERODHA_WS_RECONNECT_MAX_TRIES=50

# =============================================================================
# 3. TELEGRAM — PRIVATE CHAT / POLLING MODE
# TELEGRAM__CHAT_ID must be a numeric private chat ID without quotes or commas.
# =============================================================================
TELEGRAM_ENABLED=true

TELEGRAM__WEBHOOK_ENABLED=false
TELEGRAM_ENABLE_POLLING_FALLBACK=true
TELEGRAM__POLLING_INTERVAL_SECONDS=5
TELEGRAM_RATE_PER_SECOND=10
TELEGRAM_BURST_CAPACITY=20
TELEGRAM_LEGACY_CONSOLE_ENABLED=false

# =============================================================================
# 4. LIVE EXECUTION
# All bypass/test controls remain disabled.
# =============================================================================
ENABLE_LIVE=true
EXECUTION_MODE=LIVE
PAPER_MODE=false
SHADOW_MODE=false
BACKTEST_MODE=false

SESSION_ALLOW_OUT_OF_HOURS=false
ALLOW_OFFMARKET_TRADING=false
WS_ALLOW_OFFHOURS=false
FORCE_SIGNAL=false
RISK__SOFT_OVERRIDE=false
SKIP_APP_RISK=false
REGIME_FILTER_BYPASS=false
OPTIONS_LONG_ONLY=true
RISK_ALLOW_SHORT=false
ORDER_ALLOW_NAKED_SHORTS=false

# =============================================================================
# 5. TRADING SESSION
# 15-minute open buffer gives a 09:30 IST start.
# 30-minute pre-close buffer stops new entries at 15:00 IST.
# =============================================================================
NOTRADE__OPEN_MIN=15
NOTRADE__PRECLOSE_MIN=30
NOTRADE__LUNCH=11:30-13:15
MIDDAY_PAUSE_ENABLED=true
MIDDAY_PAUSE_START=11:30
MIDDAY_PAUSE_END=13:15

ALLOW_AFTER_MARKET_STREAMING=true
POST_MARKET_QUIET_MODE=true
POST_MARKET_BASKET_REFRESH_SECONDS=1800
POST_MARKET_MARKET_DATA_SUMMARY_SECONDS=900
POST_MARKET_SUPPRESS_CANDLE_GAP_WARNINGS=true

# =============================================================================
# 6. MARKET DATA — WEBSOCKET FIRST
# =============================================================================
WEBSOCKET__DISABLED=false
MARKETDATA_PRIMARY_SOURCE=websocket
MARKETDATA_REST_FALLBACK_ENABLED=true
MARKETDATA_REST_FALLBACK_MODE=after_ws_degraded
MARKETDATA_SUPPRESS_REST_BEFORE_WS=true
MARKETDATA_REQUIRE_WS_SPOT_FOR_LIVE=true
MARKETDATA_ALLOW_SYNTHETIC_SPOT_IN_LIVE=false

NIFTY_INTERNAL_SYMBOL=NSE:NIFTY
NIFTY_ZERODHA_QUOTE_SYMBOL="NSE:NIFTY 50"
NIFTY_SPOT_TOKEN=256265
NIFTY_EXCHANGE=NSE

STARTUP_WAIT_FOR_WS_SPOT_SECONDS=60
STARTUP_SPOT_MAX_AGE_SECONDS=120
STARTUP_BLOCK_LIVE_IF_NO_WS_SPOT=true
QUOTE_CANONICALIZE_INDEX_SYMBOLS=true
QUOTE_MARK_403_AS_REST_DEGRADED_ONLY=true
QUOTE_DO_NOT_BLOCK_IF_WS_HEALTHY=true
LOG_THROTTLE_QUOTE_ERRORS_SECONDS=120
LOG_MARKETDATA_DECISIONS=true

POLL_BATCH_SIZE=50
POLL_INTERVAL_MS_JITTER_PCT=0.15
POLL_REQUIRE_DEPTH=false
POLL_WARN_RATE_LIMIT=false

# =============================================================================
# 7. DATA FRESHNESS / EXECUTION QUOTE SAFETY
# =============================================================================
QUOTE_STALE_THRESHOLD_MS=5000
TICK_STALE_MS=5000
STALE_TICK_MAX_AGE_MS=5000
ORDER_MAX_QUOTE_AGE_MS=2000
RISK_QUOTE_STALE_MS=5000
HYDRATION_LIVE_TICK_MAX_AGE_MS=5000
HYDRATION_MAX_SPREAD_PCT=12

# =============================================================================
# 8. HISTORY / READINESS
# Keep all selected-option execution thresholds aligned.
# =============================================================================
OPTION_EXECUTION_MIN_BARS=30
READINESS_OPTION_EXEC_MIN_BARS=30
STRATEGY_MIN_INDICATOR_BARS=30

# =============================================================================
# 9. OVERLOAD PROTECTION / PERSISTENCE
# These are the merged PR #737 production defaults, made explicit.
# =============================================================================
MDM_TICK_CACHE_LEN=250
MDM_TICK_QUEUE_MAX=10000
MDM_TICK_DRAIN_BATCH=100
MDM_TICK_DRAIN_BUDGET_SECONDS=0.008
MDM_PRIORITY_CONTEXT_TTL_SECONDS=0.25
MDM_DUPLICATE_WINDOW_SEC=1.0

DATAHUB_QUOTE_CHECKPOINT_INTERVAL_SECONDS=15
DATAHUB_CLOSE_TIMEOUT_SECONDS=10
EVENT_LOOP_LAG_WARN_MS=500
EVENT_LOOP_LAG_INTERVAL_SECONDS=0.5

# =============================================================================
# 10. RISK MANAGEMENT
# Broker-reported available funds remain the LIVE source of truth.
# RISK_PER_TRADE_PCT is loss-risk sizing; capital allocation caps are separate.
# =============================================================================
RISK_MAX_DAILY_TRADES=6
MAX_TRADES_PER_DAY=6
RISK_MAX_ORDER_NOTIONAL=75000
RISK_MAX_DRAWDOWN_PCT=5.0
RISK_MAX_DAILY_LOSS_PCT=2.0
RISK_DAILY_LOSS_PCT=2.0
RISK_DAILY_PNL_CAP_PCT=2.0

RISK_MAX_POSITION_SIZE_PCT=35.0
RISK_MAX_TOTAL_EXPOSURE_PCT=35.0
RISK_MAX_CONCURRENT_POSITIONS=1
RISK_MAX_POSITIONS_PER_SYMBOL=1
RISK_MIN_RISK_REWARD_RATIO=2.0

RISK_PER_TRADE_PCT=2.5
RISK_PER_TRADE_CAP_PCT=30.0
RISK_MAX_CONSEC_LOSSES=3
RISK_LOSS_COOLDOWN_SEC=900
RISK_COOLDOWN_ON_REJECT_SECONDS=60
RISK_BREAKER_AUTO_SHADOW=true
RISK_ALLOW_PYRAMIDING=false
RISK_SIGNAL_DEBOUNCE_SECONDS=15
RISK_RESET_HOUR_UTC=3
RISK__BALANCE_REFRESH_SEC=60
RISK__BALANCE_JIT_REFRESH=1

MIN_LOTS_PER_TRADE=1
MAX_LOTS_PER_TRADE=2
ATR_MULT=1.5
NIFTY_LOT_SIZE=65

# =============================================================================
# 11. ORDER ROUTING
# Entries use LIMIT orders. Protective exits remain controlled by bracket logic.
# =============================================================================
ORDER_DEFAULT_PRODUCT=MIS
ORDER_DEFAULT_TYPE=LIMIT
ORDER_LIMIT_OFFSET_PCT=0.05
ORDER_MIN_SPACING_SECONDS=1.5
ORDER_RATE_PER_SECOND=5
ORDER_RATE_PER_MINUTE=150
ORDER_RATE_PER_DAY=2000

ORDER_RETRY_ATTEMPTS=3
ORDER_RETRY_DELAY_SECONDS=0.5
ORDER_REPLACE_ATTEMPTS=3
ORDER_REPLACE_BACKOFF_SECONDS=0.75
ORDER_REPLACE_PRICE_STEP_PCT=0.02
ORDER_REPLACE_TIMEOUT_SECONDS=0.75

ORDER_REF_REQUIRE_DEPTH=true
ORDER_ALLOW_LTP_FALLBACK=true
ORDER_ALLOW_MARKET_PROTECT=false
ENTRY_ALLOW_MARKET_PROTECT=false
ORDER_PROTECT_SLIPPAGE_BPS=12
ORDER_TRUNCATE_TO_LOT=true
ORDER_QUEUE_POLICY_ENABLED=false

# =============================================================================
# 12. RATE LIMITS
# =============================================================================
RATE_LIMIT_ORDERS_CAPACITY=5
RATE_LIMIT_ORDERS_REFILL_PER_SEC=5.0
RATE_LIMIT_REST_CAPACITY=10
RATE_LIMIT_REST_REFILL_PER_SEC=10.0
RATE_LIMIT_HIST_CAPACITY=2
RATE_LIMIT_HIST_REFILL_PER_SEC=1.0

# =============================================================================
# 13. BRACKET / POSITION LIFECYCLE
# ATR_MULT=1.5 with a 2R final trend target approximates a 3-ATR target.
# =============================================================================
EXECUTION__ENABLE_BRACKET_MANAGER=true
EXECUTION__BRACKET_AUTO_REDUCE_SL=true
EXECUTION__BRACKET_STALE_CLEANUP_SECONDS=86400

LIFECYCLE_TP1_R=1.0
LIFECYCLE_TP1_PARTIAL=0.6
LIFECYCLE_TP2_R_TREND=2.0
LIFECYCLE_TP2_R_RANGE=1.5
LIFECYCLE_TRAIL_ATR_MULT=0.8
LIFECYCLE_TIME_STOP_MIN=12

RECONCILIATION_INTERVAL_SEC=30
RECONCILIATION_ALERT_ON_MISMATCH=true
RECONCILIATION_BROKER_IS_TRUTH=true

# =============================================================================
# 14. STRIKE / EXPIRY / UNIVERSE
# =============================================================================
SELECTOR__MODE=ATM
SELECTOR__EXPIRY=weekly
SELECTOR__EXPIRY_REGIME=auto
SELECTOR__EXPIRY_ROLL_MINUTES=45
SELECTOR__MONTHLY_HALT_MINUTES=30
LEGACY_SIDE_TO_TYPE=false

OPTION_UNIVERSE__UNDERLYING=NIFTY
OPTION_UNIVERSE__EXCHANGE=NFO
OPTION_UNIVERSE__STRIKE_STEP=50
OPTION_UNIVERSE__STRIKES_AROUND_ATM=2
OPTION_UNIVERSE__MIN_TOKEN_COUNT=10
OPTION_UNIVERSE__EXPIRY_ROLL_HOURS=12
OPTION_UNIVERSE__INSTRUMENT_REFRESH=true
OPTION_UNIVERSE__REFRESH_INTERVAL_MINUTES=60
OPTION_UNIVERSE__MARKET_CLOSE_HOUR=15
OPTION_UNIVERSE__MARKET_CLOSE_MINUTE=30

SYNC_ONLY_INDEX_OPTIONS=true
SYNC_INSTRUMENTS_FILTER=NIFTY
INSTRUMENTS_REFRESH_CRON_ENABLED=true
INSTRUMENTS_REFRESH_INTERVAL_HOURS=24

# =============================================================================
# 15. LIQUIDITY
# Percentage fields use percentage units, not fractions.
# =============================================================================
LIQ__MIN_OI=0
LIQ__MAX_SPREAD_PCT=12
LIQ__MIN_TRADES=0
LIQ__MIN_TOP3_DEPTH=0

# =============================================================================
# 16. ACTIVE STRATEGIES
# Confidence values below are percentages on a 0-100 scale.
# A value such as 55 means 55%, not 0.55.
# Long-only directional strategies are enabled; complex/short-premium modes are off.
# =============================================================================
ELITE_MAX_CONCURRENT_STRATEGIES=1
ELITE_POSITION_SIZE_PCT=25.0

SMC_ENABLED=true
SMC_MIN_CONFIDENCE=55
SMC_COOLDOWN=60
SMC_SWEEP_DISTANCE=15
SMC_VOLUME_SPIKE=2.0

VWAP_ENABLED=true
VWAP_MIN_CONFIDENCE=55
VWAP_EMA_PERIOD=50
VWAP_PROXIMITY_PCT=0.15

RSI_DIV_ENABLED=true
RSI_MIN_CONFIDENCE=55
RSI_PERIOD=14

ORB_ENABLED=true
ORB_MIN_CONFIDENCE=60
ORB_MINUTES=15

OI_MAX_PAIN_ENABLED=true
OI_MIN_CONFIDENCE=55
OI_MIN_DISTANCE_PCT=0.5

CPR_ENABLED=true
CPR_MIN_CONFIDENCE=60
CPR_NARROW_THRESHOLD_PCT=0.25

ORDER_FLOW_ENABLED=true
ORDER_FLOW_MIN_CONFIDENCE=65
ORDER_FLOW_IMBALANCE_RATIO_BUY=2.8
ORDER_FLOW_LARGE_ORDER_PCT=15

BB_SQUEEZE_ENABLED=false
BB_MIN_CONFIDENCE=60
BB_SQUEEZE_BANDWIDTH=0.4

GAMMA_ENABLED=false
GAMMA_MIN_CONFIDENCE=65
GAMMA_THRESHOLD=0.0005

ENABLE_TUESDAY_GAMMA_BUYER=false
TUESDAY_GAMMA_MIN_CONFIDENCE=65
TUESDAY_GAMMA_ATR_MULTIPLIER=1.2
TUESDAY_GAMMA_TARGET_MULTIPLIER=1.8

STRADDLE_ENABLED=false
STRADDLE_MIN_CONFIDENCE=73
STRADDLE_ADX_LIMIT=25
STRADDLE_MIN_IV=12

# =============================================================================
# 17. GENERAL DIAGNOSTICS
# =============================================================================
STRATEGY_DEBUG=false
TICK_ERROR_LOG_COOLDOWN_SEC=30
TELEMETRY_TAGS=aws_lightsail,live,nifty_options

