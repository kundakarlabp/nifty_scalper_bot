# Cleaned .env (canonical)

```
# .env (cleaned - canonical keys only)
# Keep only canonical, non-duplicated variables required for runtime.
# Review values before deploying to production.

# Safety & Modes
ENABLE_LIVE=true
SHADOW_MODE=false
SESSION_ALLOW_OUT_OF_HOURS=false
EXEC_OPTIONS_ONLY=true

# Regime sizing and thresholds
REGIME_TREND_SIZING_MULT=1.15
REGIME_RANGE_SIZING_MULT=0.85
REGIME_VOLATILE_SIZING_MULT=0.70
REGIME_EVENT_SIZING_MULT=0.60
REGIME_VWAP_MAX_TREND_DISTANCE_PCT=0.0025
REGIME_QUIET_THRESHOLD_PCT=0.0007
REGIME_VOLATILE_THRESHOLD_PCT=0.0025

# Execution Configuration
EXECUTION_MODE=LIVE  # Allowed: SHADOW, PAPER, LIVE

# Data & Streaming
WS_ENABLED=false
WEBSOCKET_DISABLED=true
TELEGRAM_WEBHOOK_ENABLED=false
PRICE_SOURCE=broker
POLL_INTERVAL_MS=500
POLL_BATCH_SIZE=50
POLL_INTERVAL_MS_JITTER_PCT=0.15
QUOTE_STALE_THRESHOLD_MS=3000
RETRY_QUOTE_TRIES=3
RETRY_QUOTE_BACKOFF_MS=200

DATA_IV_ENABLED=true
DATA_OI_ENABLED=true
DATA_GREEKS_ENABLED=true
DATA_HIST_PATH=data/history
DATA_TIME_FILTER_START=09:15
DATA_TIME_FILTER_END=15:30

# Instruments & Execution Defaults
INSTRUMENTS_TRADE_SYMBOL=NIFTY
INSTRUMENTS_TRADE_EXCHANGE=NFO
INSTRUMENTS_NIFTY_LOT_SIZE=75

ORDER_DEFAULT_PRODUCT=MIS
ORDER_DEFAULT_TYPE=LIMIT
ORDER_LIMIT_OFFSET_PCT=0.05

# Paper Trading / Shadow Mode
PAPER_ENABLED=false
PAPER_SLIPPAGE_BPS=5
PAPER_PARTIAL_FILL=true
PAPER_QUEUE_SEC=0.4

# Risk Management (canonical keys)
RISK_MAX_DRAWDOWN_PCT_DAY=2.0
RISK_MAX_CONCURRENT_POS=5
RISK_PER_TRADE_RISK_PCT=5.0
RISK_MAX_CAPITAL_PER_ORDER_PCT=15.0
RISK_ATR_STOP_MULTIPLE=0.8
RISK_FALLBACK_PRICE_MOVE_PCT=2.0
MIN_LOTS_PER_TRADE=1
DEFAULT_STOP_POINTS=60
MAX_LOTS_PER_TRADE=6

MDM_STALE_THRESHOLD_MS=4000
MDM_ADAPTIVE_REFRESH=true

# Backtesting
BACKTEST_ENABLED=true
BACKTEST_START=2024-10-01
BACKTEST_END=2025-10-20
BACKTEST_CAPITAL=100000
BACKTEST_COMMISSION_PER_ORDER=20
BACKTEST_SLIPPAGE_BPS=3

# Lifecycle & Profit Targets
LIFECYCLE_TP1_R=1.0
LIFECYCLE_TP1_PARTIAL=0.6
LIFECYCLE_TP2_R_TREND=1.5
LIFECYCLE_TP2_R_RANGE=1.4
LIFECYCLE_TRAIL_ATR_MULT=0.8
LIFECYCLE_TIME_STOP_MIN=15

# Elite Strategies Configuration
ELITE_STRATEGIES_ENABLED=true
ELITE_MAX_CONCURRENT_STRATEGIES=2
ELITE_POSITION_SIZE_PCT=1.5

# SMC
SMC_ENABLED=true
SMC_MIN_CONFIDENCE=75.0
SMC_EQUAL_LEVEL_TOLERANCE_PCT=2.0
SMC_SWEEP_DISTANCE_POINTS=30.0
SMC_VOLUME_SPIKE_MULT=2.0
SMC_ORDER_BLOCK_VOLUME_MULT=1.5

# VWAP Pro
VWAP_PRO_ENABLED=true
VWAP_MIN_CONFIDENCE=72.0
VWAP_STDDEV_MULT=1.5
VWAP_RSI_OVERSOLD=35.0
VWAP_RSI_OVERBOUGHT=65.0
VWAP_VOLUME_SPIKE=1.8
VWAP_MAX_HOLDING_MIN=15.0

# OI Max Pain
OI_MAX_PAIN_ENABLED=true
OI_MIN_CONFIDENCE=68.0
OI_FETCH_INTERVAL_MIN=3.0
OI_MIN_DISTANCE_POINTS=50.0
OI_PCR_BULLISH=1.2
OI_PCR_BEARISH=0.8
OI_EXIT_TIME=900.0

# Gamma
GAMMA_ENABLED=true
GAMMA_MIN_CONFIDENCE=65.0
GAMMA_HEDGE_TRIGGER_POINTS=20.0
GAMMA_DELTA_THRESHOLD=0.2
GAMMA_TARGET_PROFIT=2500.0
GAMMA_MAX_THETA_LOSS=500.0
GAMMA_EXIT_TIME=840.0

# CPR
CPR_ENABLED=true
CPR_MIN_CONFIDENCE=68.0
CPR_NARROW_THRESHOLD_PCT=0.3
CPR_VOLUME_MULT=2.0
CPR_GAP_THRESHOLD_POINTS=30.0
CPR_BREAKOUT_WINDOW_START=570.0
CPR_BREAKOUT_WINDOW_END=600.0

# Order Flow
ORDER_FLOW_ENABLED=true
ORDER_FLOW_MIN_CONFIDENCE=70.0
ORDER_FLOW_IMBALANCE_RATIO_BUY=2.5
ORDER_FLOW_IMBALANCE_RATIO_SELL=0.4
ORDER_FLOW_LARGE_ORDER_PCT=15.0
ORDER_FLOW_PERSISTENCE_SEC=5.0
ORDER_FLOW_TARGET_POINTS=25.0

# Bollinger Band Squeeze
BB_SQUEEZE_ENABLED=true
BB_MIN_CONFIDENCE=55.0
BB_PERIOD=20
BB_STDDEV=2.0
BB_SQUEEZE_BANDWIDTH=0.4
BB_ATR_PERCENTILE=20.0
BB_VOLUME_BREAKOUT=2.5

# RSI Divergence
RSI_DIV_ENABLED=true
RSI_MIN_CONFIDENCE=62.0
RSI_PERIOD=14
RSI_OVERSOLD=35.0
RSI_OVERBOUGHT=65.0
RSI_CONFIRMATION_VOLUME=1.3
RSI_SWING_LOOKBACK=10

# ORB
ORB_ENABLED=true
ORB_MIN_CONFIDENCE=63.0
ORB_DURATION_MIN=15.0
ORB_NARROW_THRESHOLD_POINTS=50.0
ORB_VOLUME_MULT=2.0
ORB_CLOSE_STRENGTH_PCT=70.0
ORB_INVALID_TIME=690.0

# Straddle
STRADDLE_ENABLED=true
STRADDLE_MIN_CONFIDENCE=73.0
STRADDLE_VIX_THRESHOLD=13.0
STRADDLE_ENTRY_TIME=565.0
STRADDLE_PROFIT_TARGET_PCT=65.0
STRADDLE_MAX_SPOT_MOVE_POINTS=150.0
STRADDLE_EXIT_TIME=900.0

# Persistence & Logging (canonical)
PNL_PERSIST_PATH=data/pnl_state.json
LOG_LEVEL=info
LOG_RATE_LIMIT_SEC=30
METRICS_ENABLED=true
METRICS_PORT=8080
TELEMETRY_TAGS="production,elite"
LOG_DEDUP_WINDOW_SEC=15
LOG_OVERRIDE_NIFTY_SCALPER_BOT_RISK_REGIME_SIZING=WARNING
LOG_OVERRIDE_NIFTY_SCALPER_BOT_INFRA_PERSISTENCE=WARNING

```
