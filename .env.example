# =============================================================================
# NIFTY SCALPER BOT - SAFE CONFIGURATION TEMPLATE
# =============================================================================
# Production AWS Lightsail credentials belong only in:
# /home/ubuntu/.config/niftybot/niftybot.env
# Never commit populated credential values.
#
# This template intentionally keeps all credential/token values blank.
# Copy to .env or the production env file, then populate secrets outside git.
# =============================================================================

# =============================================================================
# DEPLOYMENT / PATHS
# =============================================================================
DEPLOYMENT_PLATFORM=aws_lightsail
BOT_APP_DIR=/home/ubuntu/nifty_scalper_bot
BOT_SERVICE_NAME=niftybot
BOT_ENV_FILE=/home/ubuntu/.config/niftybot/niftybot.env
PORT=8080
DATA_DIR=/home/ubuntu/nifty_scalper_bot/data
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# =============================================================================
# LIVE / PAPER / SHADOW MODE
# Keep live disabled in the template. Enable live only in private runtime env.
# =============================================================================
ENABLE_LIVE=false
ENABLE_LIVE_TRADING=false
ENABLE_TRADING=false
ALLOW_LIVE_ORDERS=false
EXECUTION_MODE=SHADOW
ORDERS__ENABLE_LIVE=false
PAPER__ENABLED=true
PAPER_MODE=true
SHADOW_MODE=true
ALLOW_DEBUG_ENV=false
BACKTEST_MODE=false

# =============================================================================
# BROKER / ZERODHA / KITE - KEEP BLANK IN GIT
# =============================================================================
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCESS_TOKEN=
BROKER_BASE_URL=https://api.kite.trade
BROKER_WS_URL=wss://ws.kite.trade

ZERODHA_API_KEY=
ZERODHA_API_SECRET=
