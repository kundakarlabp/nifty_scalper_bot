# Local development template only. Copy to an untracked local file and add secrets there.
# AWS Lightsail production uses /home/ubuntu/.config/niftybot/niftybot.env.

DEPLOYMENT_PLATFORM=aws_lightsail
BOT_APP_DIR=/home/ubuntu/nifty_scalper_bot
BOT_SERVICE_NAME=niftybot
BOT_ENV_FILE=/home/ubuntu/.config/niftybot/niftybot.env
PORT=8080
DATA_DIR=/home/ubuntu/nifty_scalper_bot/data

# Safe execution defaults
ENABLE_LIVE=false
EXECUTION_MODE=SHADOW
ALLOW_DEBUG_ENV=false

# Zerodha credentials. Never commit populated values.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Optional aliases accepted by the configuration layer.
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCESS_TOKEN=
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_ID=
