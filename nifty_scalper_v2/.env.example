# NiftyScalperBot v2 — Environment Variable Reference
# Copy to .env and fill in your values. Never commit .env to git.

# ============================================================
# BROKER (Zerodha Kite)
# ============================================================
BROKER__API_KEY=your_kite_api_key_here
BROKER__API_SECRET=your_kite_api_secret_here
BROKER__ACCESS_TOKEN=your_daily_access_token_here
BROKER__BASE_URL=https://api.kite.trade
BROKER__WS_URL=wss://ws.kite.trade
BROKER__TIMEOUT_SECONDS=10.0
BROKER__CONNECT_RETRIES=3
BROKER__RATE_LIMIT_ORDERS_PER_SEC=5.0
BROKER__RATE_LIMIT_REST_PER_SEC=10.0

# ============================================================
# TRADING
# ============================================================
TRADING__EXECUTION_MODE=PAPER          # LIVE | PAPER | SHADOW
TRADING__ENABLE_LIVE=false             # Must be true to enable live orders
TRADING__INSTRUMENT=NIFTY
TRADING__EXCHANGE=NFO
TRADING__LOT_SIZE=50
TRADING__TICK_SIZE=0.05
TRADING__MAX_STRIKES_FROM_ATM=5
TRADING__PREFERRED_EXPIRY=weekly       # weekly | monthly

# ============================================================
# RISK
# ============================================================
RISK__CAPITAL=1000000.0
RISK__MAX_DAILY_TRADES=30
RISK__DAILY_LOSS_PCT=2.0
RISK__MAX_ORDER_NOTIONAL=200000.0
RISK__MAX_CONCURRENT_POSITIONS=3
RISK__MAX_POSITIONS_PER_SYMBOL=1
RISK__CONSECUTIVE_LOSS_COOLDOWN=3
RISK__COOLDOWN_MINUTES=30
RISK__MIN_OPTION_OI=100
RISK__MAX_SPREAD_PCT=3.0
RISK__MIN_OPTION_PRICE=5.0
RISK__MAX_OPTION_PRICE=500.0
RISK__VIX_HIGH_THRESHOLD=20.0
RISK__VIX_EXTREME_THRESHOLD=30.0

# ============================================================
# LIFECYCLE (SL/TP/Trailing)
# ============================================================
LIFECYCLE__TP1_R=1.0
LIFECYCLE__TP1_PARTIAL=0.6
LIFECYCLE__TP2_R_TREND=1.8
LIFECYCLE__TP2_R_RANGE=1.4
LIFECYCLE__TRAIL_ATR_MULT=0.8
LIFECYCLE__TIME_STOP_MIN=12
LIFECYCLE__TRAIL_ACTIVATION_R=1.0

# ============================================================
# EXECUTION
# ============================================================
EXECUTION__ORDER_TYPE=MARKET           # MARKET | LIMIT
EXECUTION__LIMIT_OFFSET_TICKS=2
EXECUTION__SLIPPAGE_MODEL=SPREAD_HALF  # ZERO | SPREAD_HALF | FIXED
EXECUTION__RECONCILE_INTERVAL_SEC=30
EXECUTION__MAX_FILL_WAIT_SEC=60

# ============================================================
# STREAMING
# ============================================================
STREAMING__WEBSOCKET_DISABLED=false
STREAMING__POLLING_INTERVAL_MS=1000
STREAMING__WARMUP_TICKS=100
STREAMING__WARMUP_CANDLES=20
STREAMING__MAX_RECONNECT_ATTEMPTS=10
STREAMING__RECONNECT_BACKOFF_BASE=2.0

# ============================================================
# STRATEGIES (per-strategy overrides)
# ============================================================
SMC_LIQUIDITY__ENABLED=true
SMC_LIQUIDITY__MIN_CONFIDENCE=0.60
SMC_LIQUIDITY__COOLDOWN_SEC=300
SMC_LIQUIDITY__MAX_DAILY_SIGNALS=5

VWAP_PRO__ENABLED=true
VWAP_PRO__MIN_CONFIDENCE=0.60
VWAP_PRO__COOLDOWN_SEC=300
VWAP_PRO__MAX_DAILY_SIGNALS=5

RSI_DIVERGENCE__ENABLED=true
RSI_DIVERGENCE__MIN_CONFIDENCE=0.60
RSI_DIVERGENCE__COOLDOWN_SEC=300
RSI_DIVERGENCE__MAX_DAILY_SIGNALS=5

GAMMA_SCALPING__ENABLED=true
GAMMA_SCALPING__MIN_CONFIDENCE=0.60
GAMMA_SCALPING__COOLDOWN_SEC=300
GAMMA_SCALPING__MAX_DAILY_SIGNALS=5

OI_MAX_PAIN__ENABLED=true
OI_MAX_PAIN__MIN_CONFIDENCE=0.60
OI_MAX_PAIN__COOLDOWN_SEC=300
OI_MAX_PAIN__MAX_DAILY_SIGNALS=5

ORB_PRO__ENABLED=true
ORB_PRO__MIN_CONFIDENCE=0.60
ORB_PRO__COOLDOWN_SEC=300
ORB_PRO__MAX_DAILY_SIGNALS=5

BB_SQUEEZE__ENABLED=true
BB_SQUEEZE__MIN_CONFIDENCE=0.60
BB_SQUEEZE__COOLDOWN_SEC=300
BB_SQUEEZE__MAX_DAILY_SIGNALS=5

CPR_BREAKOUT__ENABLED=true
CPR_BREAKOUT__MIN_CONFIDENCE=0.60
CPR_BREAKOUT__COOLDOWN_SEC=300
CPR_BREAKOUT__MAX_DAILY_SIGNALS=5

ORDER_FLOW__ENABLED=true
ORDER_FLOW__MIN_CONFIDENCE=0.60
ORDER_FLOW__COOLDOWN_SEC=300
ORDER_FLOW__MAX_DAILY_SIGNALS=5

STRADDLE_THETA__ENABLED=true
STRADDLE_THETA__MIN_CONFIDENCE=0.60
STRADDLE_THETA__COOLDOWN_SEC=300
STRADDLE_THETA__MAX_DAILY_SIGNALS=5

TREND_MOMENTUM__ENABLED=true
TREND_MOMENTUM__MIN_CONFIDENCE=0.60
TREND_MOMENTUM__COOLDOWN_SEC=300
TREND_MOMENTUM__MAX_DAILY_SIGNALS=5

TUESDAY_GAMMA__ENABLED=true
TUESDAY_GAMMA__MIN_CONFIDENCE=0.60
TUESDAY_GAMMA__COOLDOWN_SEC=300
TUESDAY_GAMMA__MAX_DAILY_SIGNALS=5

# ============================================================
# TELEGRAM
# ============================================================
TELEGRAM__BOT_TOKEN=your_telegram_bot_token
TELEGRAM__CHAT_ID=123456789
# TELEGRAM__WEBHOOK_URL=https://your-domain.com/webhook
TELEGRAM__USE_POLLING=true
TELEGRAM__RATE_LIMIT_PER_MIN=20

# ============================================================
# INFRA
# ============================================================
INFRA__METRICS_PORT=9090
INFRA__API_PORT=8000
INFRA__DB_PATH=./data/journal.db
INFRA__LOG_LEVEL=INFO
INFRA__LOG_FORMAT=json                 # json | console
INFRA__DAILY_SUMMARY_TIME=15:20
