# ================================================================================
# NIFTY SCALPER BOT - COMPLETE .env CONFIGURATION
# ================================================================================
# Production-ready configuration with all 150+ environment variables
# Last updated: 2025-12-10
# ================================================================================

# ================================================================================
# API CREDENTIALS (Required for live trading)
# ================================================================================
# Note: These should be set in Railway/environment, not in .env for security

# KITE_API_KEY=your_api_key_here
# KITE_API_SECRET=your_api_secret_here
# KITE_ACCESS_TOKEN=your_access_token_here


# ================================================================================
# TELEGRAM NOTIFICATIONS (Optional but recommended)
# ================================================================================
TELEGRAM__BOT_TOKEN="8341776152:AAG8FEzLKwuUJUlKTWvz_IzwFIMpnFrAD7U"
TELEGRAM__CHAT_ID="8341776152"
TELEGRAM__ENABLED=true
TELEGRAM__WEBHOOK_ENABLED=false
TELEGRAM_PUBLIC_BASE_URL=""


# ================================================================================
# EXECUTION CONFIGURATION (CRITICAL FOR TRADING)
# ================================================================================
EXECUTION_MODE=LIVE                              # Allowed: SHADOW, PAPER, LIVE
SHADOW_MODE=false                                # Enable shadow trading (paper + live)
PAPER__ENABLED=false                             # Enable paper trading mode
SESSION_ALLOW_OUT_OF_HOURS=true                  # Allow trading outside market hours
ENABLE_LIVE=true                                 # Enable live trading

# Trading session configuration
OVERRIDE_OUT_OF_HOURS=true                     # Override trading window checks

# Strategy runner configuration
STRATEGY_RUNNER__SIGNAL_COOLDOWN_SECONDS=3.0     # Signal cooldown (3 seconds)
STRATEGY_RUNNER__TRADE_COOLDOWN_SECONDS=10.0    # Trade cooldown (10 seconds)
STRATEGY_RUNNER__MIN_INDICATOR_BARS=15           # Min bars before signals (15 minutes)

# ================================================================================
# DATA & STREAMING CONFIGURATION
# ================================================================================
WEBSOCKET__DISABLED=true                         # Use polling instead of WebSocket (recommended for Railway)
POLL_INTERVAL_MS=1000                             # Polling interval in milliseconds
POLL_BATCH_SIZE=50                               # Batch size for polling requests
POLL_INTERVAL_MS_JITTER_PCT=0.15                 # Jitter percentage (15%)
POLL_ADD_SYNTHETIC_DEPTH=true                    # Add synthetic depth to quotes
POLL_REQUIRE_DEPTH=true                          # Require depth data in quotes

DATA__HIST_PATH=data/history                     # Path to historical data
DATA__TIME_FILTER_START=09:15                    # Market open time
DATA__TIME_FILTER_END=15:30                      # Market close time
DATA__IV_ENABLED=true                            # Enable implied volatility data
DATA__OI_ENABLED=true                            # Enable open interest data
DATA__GREEKS_ENABLED=true                        # Enable Greeks calculation

QUOTE_STALE_THRESHOLD_MS=1500                    # Quote staleness threshold (ms)
STALE_THRESHOLD_MS=1500                          # Alternative stale threshold
MARKET_DATA_MODE=polling                         # Data mode: polling, websocket, hybrid


# ================================================================================
# INSTRUMENTS & SYMBOL CONFIGURATION
# ================================================================================
INSTRUMENTS__TRADE_SYMBOL=NIFTY                  # Trading symbol
INSTRUMENTS__TRADE_EXCHANGE=NFO                  # Trading exchange
INSTRUMENTS__NIFTY_LOT_SIZE=75                   # NIFTY lot size (75 shares)
RESOLVER_STRIP_EXCHANGE_PREFIX=true              # Strip exchange prefix from symbols

SQLITE_DB_PATH=data/instruments.db               # Instrument database path


# ================================================================================
# OPTION CHAIN CONFIGURATION
# ================================================================================
OPTION_CHAIN__PREFER_EXPIRY_TYPE=WEEKLY          # Prefer weekly expiry
OPTION_CHAIN__FALLBACK_EXPIRY_TYPE=MONTHLY       # Fallback to monthly
OPTION_CHAIN__STRIKE_OFFSET=0                    # Strike offset (0=ATM, 100=+1 level)
OPTION_CHAIN__TRADE_CALL=true                    # Trade call options
OPTION_CHAIN__TRADE_PUT=true                     # Trade put options
OPTION_CHAIN__REFRESH_INTERVAL_MIN=60            # Refresh interval (minutes)
OPTION_CHAIN__MIN_DAYS_TO_EXPIRY=1.0             # Minimum days to expiry


# ================================================================================
# ORDER CONFIGURATION
# ================================================================================
ORDER_DEFAULT_PRODUCT=MIS                        # Order product type (MIS, CNC, NRML)
ORDER_DEFAULT_TYPE=LIMIT                         # Order type (LIMIT, MARKET)
ORDER_LIMIT_OFFSET_PCT=0.05                      # Limit order offset percentage (5 bps)


# ================================================================================
# PAPER TRADING CONFIGURATION
# ================================================================================
PAPER__SLIPPAGE_BPS=5                            # Paper trading slippage (5 bps)
PAPER__PARTIAL_FILL=true                         # Allow partial fills in paper mode
PAPER__QUEUE_SEC=0.4                             # Order queue delay (seconds)


# ================================================================================
# RISK MANAGEMENT CONFIGURATION
# ================================================================================
RISK__CIRCUIT_BREAKER_ENABLED=false
RISK__MAX_DRAWDOWN_PCT_DAY=2.0                   # Max daily drawdown (2%)
RISK__MAX_CONCURRENT_POS=5                       # Max concurrent positions
RISK__PER_TRADE_RISK_PCT=5.0                     # Risk per trade (5%)
RISK__MAX_CAPITAL_PER_ORDER_PCT=15.0             # Max capital per order (15%)
RISK_PER_TRADE_PCT=2.0                           # Alternative risk per trade (2%)
RISK_PER_TRADE_CAP_PCT=25.0                      # Alternative max capital (25%)
RISK_FALLBACK_PRICE_MOVE_PCT=2.0                 # Fallback price move for SL calculation

MIN_LOTS_PER_TRADE=1                             # Minimum lots per trade
MAX_LOTS_PER_TRADE=2                             # Maximum lots per trade

# Risk manager filter
REGIME_FILTER_BYPASS=true                        # Bypass regime filter for testing


# ================================================================================
# REGIME DETECTION & SIZING
# ================================================================================
REGIME_TREND_SIZING_MULT=1.15                    # Trend regime sizing multiplier
REGIME_RANGE_SIZING_MULT=0.85                    # Range regime sizing multiplier
REGIME_VOLATILE_SIZING_MULT=0.70                 # Volatile regime sizing multiplier
REGIME_EVENT_SIZING_MULT=0.60                    # Event regime sizing multiplier

REGIME__VWAP_MAX_TREND_DISTANCE_PCT=0.0025       # VWAP max trend distance (0.25%)
REGIME__QUIET_THRESHOLD_PCT=0.0007               # Quiet threshold (0.07%)
REGIME__VOLATILE_THRESHOLD_PCT=0.0025            # Volatile threshold (0.25%)


# ================================================================================
# ELITE STRATEGIES - MASTER ENABLER (CRITICAL FOR TRADING)
# ================================================================================
ELITE_STRATEGIES_ENABLED=true                    # Enable elite strategy framework
ELITE_MAX_CONCURRENT_STRATEGIES=10                # Max concurrent strategies
ELITE_POSITION_SIZE_PCT=1.5                      # Position size (1.5% of capital)


# ================================================================================
# SMC STRATEGY (Smart Money Concepts)
# ================================================================================
SMC_ENABLED=true                                 # Enable SMC strategy
SMC_MIN_CONFIDENCE=40.0                          # Min confidence threshold (40%)
SMC_EQUAL_LEVEL_TOLERANCE_PCT=2.0                # Equal level tolerance (2%)
SMC_SWEEP_DISTANCE_POINTS=30.0                   # Sweep distance (30 points)
SMC_VOLUME_SPIKE_MULT=2.0                        # Volume spike multiplier
SMC_ORDER_BLOCK_VOLUME_MULT=1.5                  # Order block volume multiplier


# ================================================================================
# VWAP PRO STRATEGY
# ================================================================================
VWAP_PRO_ENABLED=true                            # Enable VWAP Pro strategy
VWAP_MIN_CONFIDENCE=40.0                         # Min confidence threshold (40%)
VWAP_STDDEV_MULT=1.5                             # Standard deviation multiplier
VWAP_RSI_OVERSOLD=45.0                           # RSI oversold threshold (45)
VWAP_RSI_OVERBOUGHT=55.0                         # RSI overbought threshold (55)
VWAP_VOLUME_SPIKE=1.8                            # Volume spike threshold
VWAP_MAX_HOLDING_MIN=15.0                        # Max holding time (15 minutes)


# ================================================================================
# OI MAX PAIN STRATEGY
# ================================================================================
OI_MAX_PAIN_ENABLED=true                         # Enable OI Max Pain strategy
OI_MIN_CONFIDENCE=40.0                           # Min confidence threshold (40%)
OI_FETCH_INTERVAL_MIN=3.0                        # Fetch interval (3 minutes)
OI_MIN_DISTANCE_POINTS=50.0                      # Min distance from spot (50 points)
OI_PCR_BULLISH=1.2                               # Bullish PCR threshold
OI_PCR_BEARISH=0.8                               # Bearish PCR threshold
OI_EXIT_TIME=900.0                               # Exit time (15 minutes)


# ================================================================================
# GAMMA SCALPING STRATEGY
# ================================================================================
GAMMA_ENABLED=true                               # Enable Gamma strategy
GAMMA_MIN_CONFIDENCE=65.0                        # Min confidence threshold (65%)
GAMMA_HEDGE_TRIGGER_POINTS=20.0                  # Hedge trigger (20 points)
GAMMA_DELTA_THRESHOLD=0.2                        # Delta threshold for hedging
GAMMA_TARGET_PROFIT=2500.0                       # Target profit (₹2500)
GAMMA_MAX_THETA_LOSS=500.0                       # Max theta loss (₹500)
GAMMA_EXIT_TIME=840.0                            # Exit time (14 minutes)


# ================================================================================
# CAMARILLA PIVOT RANGE (CPR) STRATEGY
# ================================================================================
CPR_ENABLED=true                                 # Enable CPR strategy
CPR_MIN_CONFIDENCE=68.0                          # Min confidence threshold (68%)
CPR_NARROW_THRESHOLD_PCT=0.3                     # Narrow CPR threshold (0.3%)
CPR_VOLUME_MULT=2.0                              # Volume multiplier
CPR_GAP_THRESHOLD_POINTS=30.0                    # Gap threshold (30 points)
CPR_BREAKOUT_WINDOW_START=570.0                  # Breakout window start (9:30)
CPR_BREAKOUT_WINDOW_END=600.0                    # Breakout window end (10:00)


# ================================================================================
# ORDER FLOW IMBALANCE STRATEGY
# ================================================================================
ORDER_FLOW_ENABLED=true                          # Enable Order Flow strategy
ORDER_FLOW_MIN_CONFIDENCE=70.0                   # Min confidence threshold (70%)
ORDER_FLOW_IMBALANCE_RATIO_BUY=2.5               # Buy imbalance ratio
ORDER_FLOW_IMBALANCE_RATIO_SELL=0.4              # Sell imbalance ratio
ORDER_FLOW_LARGE_ORDER_PCT=15.0                  # Large order percentage (15%)
ORDER_FLOW_PERSISTENCE_SEC=5.0                   # Persistence check (5 seconds)
ORDER_FLOW_TARGET_POINTS=25.0                    # Target points (25)


# ================================================================================
# BOLLINGER BANDS SQUEEZE STRATEGY
# ================================================================================
BB_SQUEEZE_ENABLED=true                          # Enable BB Squeeze strategy
BB_MIN_CONFIDENCE=55.0                           # Min confidence threshold (55%)
BB_PERIOD=20                                     # Period for BB calculation
BB_STDDEV=2.0                                    # Standard deviation
BB_SQUEEZE_BANDWIDTH=0.4                         # Squeeze bandwidth (0.4)
BB_ATR_PERCENTILE=20.0                           # ATR percentile (20th)
BB_VOLUME_BREAKOUT=2.5                           # Volume breakout multiplier


# ================================================================================
# RSI DIVERGENCE STRATEGY
# ================================================================================
RSI_DIV_ENABLED=true                             # Enable RSI Divergence strategy
RSI_MIN_CONFIDENCE=40.0                          # Min confidence threshold (40%)
RSI_PERIOD=14                                    # RSI period
RSI_OVERSOLD=35.0                                # Oversold threshold
RSI_OVERBOUGHT=65.0                              # Overbought threshold
RSI_CONFIRMATION_VOLUME=1.3                      # Volume confirmation multiplier
RSI_SWING_LOOKBACK=10                            # Swing lookback period


# ================================================================================
# OPENING RANGE BREAKOUT (ORB) STRATEGY
# ================================================================================
ORB_ENABLED=true                                 # Enable ORB strategy
ORB_MIN_CONFIDENCE=63.0                          # Min confidence threshold (63%)
ORB_DURATION_MIN=15.0                            # ORB duration (15 minutes)
ORB_NARROW_THRESHOLD_POINTS=50.0                 # Narrow range threshold (50 points)
ORB_VOLUME_MULT=2.0                              # Volume multiplier
ORB_CLOSE_STRENGTH_PCT=70.0                      # Close strength percentage (70%)
ORB_INVALID_TIME=690.0                           # Invalid time for ORB (11:30)


# ================================================================================
# STRADDLE STRATEGY
# ================================================================================
STRADDLE_ENABLED=true                            # Enable Straddle strategy
STRADDLE_MIN_CONFIDENCE=73.0                     # Min confidence threshold (73%)
STRADDLE_VIX_THRESHOLD=13.0                      # VIX threshold
STRADDLE_ENTRY_TIME=565.0                        # Entry time (9:25)
STRADDLE_PROFIT_TARGET_PCT=65.0                  # Profit target (65%)
STRADDLE_MAX_SPOT_MOVE_POINTS=150.0              # Max spot move (150 points)
STRADDLE_EXIT_TIME=900.0                         # Exit time (15 minutes)


# ================================================================================
# LIFECYCLE & PROFIT TARGETS
# ================================================================================
LIFECYCLE_TP1_R=1.0                              # TP1 R-multiple (1x risk)
LIFECYCLE_TP1_PARTIAL=0.6                        # TP1 partial exit (60%)
LIFECYCLE_TP2_R_TREND=1.5                        # TP2 R-multiple in trend (1.5x)
LIFECYCLE_TP2_R_RANGE=1.4                        # TP2 R-multiple in range (1.4x)
LIFECYCLE_TRAIL_ATR_MULT=0.8                     # Trailing stop ATR multiplier
LIFECYCLE_TIME_STOP_MIN=15                       # Time-based stop (15 minutes)


# ================================================================================
# BACKTESTING CONFIGURATION
# ================================================================================
BACKTEST__ENABLED=true                           # Enable backtesting
BACKTEST__START=2024-10-01                       # Backtest start date
BACKTEST__END=2025-10-20                         # Backtest end date
BACKTEST__CAPITAL=100000                         # Initial capital (₹100,000)
BACKTEST__COMMISSION_PER_ORDER=20                # Commission per order (₹20)
BACKTEST__SLIPPAGE_BPS=3                         # Slippage (3 bps)


# ================================================================================
# PERSISTENCE & STORAGE
# ================================================================================
PNL_PERSIST_PATH=data/pnl_state.json             # P&L persistence file
SQLITE_DB_PATH=data/instruments.db               # Instrument database


# ================================================================================
# LOGGING & DEBUGGING
# ================================================================================
LOG_LEVEL=info                                  # Log level: debug, info, warning, error
LOG_RATE_LIMIT_SEC=30                            # Rate limit for duplicate logs (30 sec)
LOG_DEDUP_WINDOW_SEC=15                          # Dedup window for logs (15 sec)

# Log overrides for specific modules
LOG_OVERRIDE_nifty_scalper_bot.risk.regime_sizing=WARNING
LOG_OVERRIDE_nifty_scalper_bot.infra.persistence=WARNING
LOG_OVERRIDE_nifty_scalper_bot.infra.metrics=WARNING
LOG_OVERRIDE_nifty_scalper_bot.data.market_data_manager=INFO

PYTHONUNBUFFERED=1                               # Unbuffered Python output
PYTHONPATH=src                                   # Python path


# ================================================================================
# METRICS & MONITORING
# ================================================================================
METRICS_ENABLED=true                             # Enable Prometheus metrics
METRICS_PORT=8080                                # Metrics port
TELEMETRY_TAGS=production,elite                  # Telemetry tags
ENABLE_EMBEDDED_HTTP_SERVER=true                 # Enable embedded HTTP server
PORT=8000                                        # HTTP server port (Railway default)
PROMETHEUS_MULTIPROC_DIR=/tmp                    # Prometheus multiprocess directory


# ================================================================================
# ZERODHA WEBSOCKET CONFIGURATION
# ================================================================================
ZERODHA_WS_ORIGIN=https://kite.zerodha.com       # WebSocket origin
ZERODHA_WS_CONNECT_TIMEOUT=60                    # Connection timeout (60 sec)
ZERODHA_WS_RECONNECT_MAX_TRIES=50                # Max reconnection attempts


# ================================================================================
# ADDITIONAL CONFIGURATION
# ================================================================================
exc_info=True                                    # Include exception info in logs

# ================================================================================
# END OF CONFIGURATION
# ================================================================================
# All 150+ production-ready environment variables configured
# Ready for deployment to Railway or other cloud platforms
