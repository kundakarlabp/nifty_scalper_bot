# ================================================================================
# NIFTY SCALPER BOT - OPTIMIZED PRODUCTION CONFIGURATION
# ================================================================================

# --- API & TELEGRAM ---
TELEGRAM__ENABLED=true
TELEGRAM__WEBHOOK_ENABLED=false

RISK__SOFT_OVERRIDE=true
# --- EXECUTION ENGINE ---
EXECUTION_MODE=LIVE                              # Options: SHADOW, PAPER, LIVE
ENABLE_LIVE=true
SESSION_ALLOW_OUT_OF_HOURS=true                  
OVERRIDE_OUT_OF_HOURS=true                       # Forced for 24/7 signal testing

# --- DATA STREAMING (Railway Optimized) ---
WEBSOCKET__DISABLED=true                         # Polling is more stable on cloud instances
POLL_INTERVAL_MS=1000
MARKET_DATA_MODE=polling

# --- INSTRUMENTS ---
INSTRUMENTS__TRADE_SYMBOL=NIFTY
NIFTY_LOT_SIZE=65                                # Standard Nifty lot size
INSTRUMENTS__TRADE_EXCHANGE=NFO

# --- BASE STRATEGY GATEKEEPER (Option Health) ---
# These parameters prevent buying "junk" options
MIN_OPEN_INTEREST=75000                          # Liquidity floor
MAX_BID_ASK_SPREAD=3.5                           # Avoid high spread tax
MIN_OPTION_DELTA=0.35                            # Avoid deep OTM options
MAX_IV_PERCENTILE=85.0                           # Avoid overpriced tops

# --- ELITE STRATEGY MASTER CONTROLS ---
ELITE_STRATEGIES_ENABLED=true
ELITE_MAX_CONCURRENT_STRATEGIES=10
ELITE_POSITION_SIZE_PCT=1.5

# --- SMC STRATEGY (Smart Money Concepts) ---
SMC_ENABLED=true
SMC_MIN_CONFIDENCE=45.0                          # Tuned for better midday frequency
SMC_EQUAL_LEVEL_TOLERANCE_PCT=2.0                # Validated by elite_validator.py
SMC_SWEEP_DISTANCE_POINTS=10.0                   # Reduced for tighter Nifty moves
SMC_VOLUME_SPIKE_MULT=2.2                        # Requires clear institutional conviction

# --- VWAP PRO STRATEGY ---
VWAP_PRO_ENABLED=true
VWAP_MIN_CONFIDENCE=40.0
VWAP_STDDEV_MULT=1.5
VWAP_VOLUME_SPIKE=1.8
VWAP_RSI_OVERSOLD=42.0                           # Standard RSI reversal floor
VWAP_RSI_OVERBOUGHT=58.0                         # Standard RSI reversal ceiling

# --- RSI DIVERGENCE STRATEGY ---
RSI_DIV_ENABLED=true
RSI_MIN_CONFIDENCE=45.0
RSI_PERIOD=14
RSI_SWING_LOOKBACK=15                            # Expanded for better pattern detection
RSI_CONFIRMATION_VOLUME=1.2                      # Lowered to capture early breakouts

# --- CAMARILLA PIVOT RANGE (CPR) ---
CPR_ENABLED=true
CPR_MIN_CONFIDENCE=55.0
CPR_NARROW_THRESHOLD_PCT=0.25                    # Focus on narrow range breakouts
CPR_BREAKOUT_WINDOW_START=09:30                  # Standard market opening window
CPR_BREAKOUT_WINDOW_END=10:30

# --- ORDER FLOW IMBALANCE ---
ORDER_FLOW_ENABLED=true
ORDER_FLOW_MIN_CONFIDENCE=60.0
ORDER_FLOW_IMBALANCE_RATIO_BUY=2.8               # Aggressive buy threshold
ORDER_FLOW_IMBALANCE_RATIO_SELL=0.35             # Aggressive sell threshold
ORDER_FLOW_PERSISTENCE_SEC=3.0                   # Lowered for faster scalping response

# --- OPENING RANGE BREAKOUT (ORB) ---
ORB_ENABLED=true
ORB_MIN_CONFIDENCE=55.0
ORB_DURATION_MIN=15.0
ORB_INVALID_TIME=11:30                           # Stop ORB after initial volatility

# --- RISK & LIFECYCLE ---
REGIME_FILTER_BYPASS=true                        # Allow all strategies to fire for tuning
LIFECYCLE_TP1_R=1.0                              # Secure profits at 1x Risk
LIFECYCLE_TP1_PARTIAL=0.5                        # Exit 50% at TP1
LIFECYCLE_TRAIL_ATR_MULT=1.2                     # ATR-based trailing stop

# --- SYSTEM SETTINGS ---
LOG_LEVEL=info
PYTHONPATH=src
PYTHONUNBUFFERED=1
