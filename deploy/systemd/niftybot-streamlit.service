[Unit]
Description=Nifty Scalper Superlite Review Console
After=network-online.target niftybot.service niftybot-admin.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/nifty_scalper_bot
EnvironmentFile=/home/ubuntu/.config/niftybot/niftybot.env
Environment=BOT_ADMIN_API_URL=http://127.0.0.1:8081
Environment=BOT_ADMIN_PUBLIC_URL=http://15.206.3.6:8081/admin
Environment=BOT_SERVICE_NAME=niftybot
Environment=BOT_APP_DIR=/home/ubuntu/nifty_scalper_bot
Environment=DEPLOYMENT_PLATFORM=aws_lightsail
Environment=PYTHONPATH=/home/ubuntu/nifty_scalper_bot:/home/ubuntu/nifty_scalper_bot/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/nifty_scalper_bot/.streamlit-venv/bin/python -m streamlit run /home/ubuntu/nifty_scalper_bot/dashboard/superlite_console.py --server.address=0.0.0.0 --server.port=8501 --browser.gatherUsageStats=false --server.headless=true --server.fileWatcherType=none --server.runOnSave=false --server.enableWebsocketCompression=false --server.maxUploadSize=5 --server.maxMessageSize=20 --client.toolbarMode=minimal
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
Nice=8
CPUWeight=10
MemoryHigh=220M
MemoryMax=320M

[Install]
WantedBy=multi-user.target
